# Lenta API base
LENTA_BASE_URL=https://lenta.com
LENTA_CITY_KEY=spb
LENTA_DEFAULT_STORE_ID=       # empty = auto-pick first spb store after OTP verify
LENTA_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.0.0 Safari/537.36
LENTA_TIMEOUT=10

# Device identity (any UUIDs)
LENTA_DEVICE_ID=             # empty = generated on startup
LENTA_SESSION_ID=            # empty = generated on startup

# Qrator solver
LENTA_QRATOR_REFRESH_SECONDS=3600

# NOTE: phone + SMS OTP are NOT env vars anymore — pass them via HTTP:
#   POST /api/auth/login  {"phone": "7XXXXXXXXXX"}   → sends SMS
#   POST /api/auth/verify  {"code": "1234"}            → saves session